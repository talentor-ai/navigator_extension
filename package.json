{
  "name": "talentor-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:extension": "bun run --cwd apps/extension dev",
    "build": "bun run build:web && bun run build:extension",
    "build:web": "bun run --cwd apps/web build",
    "build:extension": "bun run --cwd apps/extension build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "bun run typecheck:extension && bun run typecheck:web && bun run typecheck:contracts && bun run typecheck:api-client",
    "typecheck:extension": "bun run --cwd apps/extension typecheck",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "typecheck:contracts": "bun run --cwd packages/contracts typecheck",
    "typecheck:api-client": "bun run --cwd packages/api-client typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate:contracts": "bun run scripts/generate-contracts.ts",
    "deps:latest": "bun run scripts/install-latest-dependencies.ts",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,css,md,json,html}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
